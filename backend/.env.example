# ── Phantom 2.0 backend env ──────────────────────────────────────────────────
# Copy to .env and fill. .env is gitignored — never commit real keys.

PORT=3020
NODE_ENV=development

# Public gate: 1 = everyone sees coming-soon.html except logged-in operators.
COMING_SOON=1

# Operator login (coming-soon lock icon → /app/admin-login.html)
ADMIN_USERNAME=
ADMIN_PASSWORD=
COOKIE_SECURE=0            # 1 in prod (HTTPS only)
SESSION_TTL_DAYS=30

# ── LLM boundary (lib/llm.js) ────────────────────────────────────────────────
# mock         → deterministic canned output, $0 (default — spend is opt-in)
# claude_code  → local logged-in Claude Code CLI (Max subscription, $0 API) — dev machine only
# anthropic_api→ real Anthropic SDK (prod)
CLAUDE_MODE=mock
ANTHROPIC_API_KEY=
# Model routing per task tier (env-overridable; see lib/llm.js)
ANTHROPIC_MODEL_SYNTHESIS=claude-opus-4-8
ANTHROPIC_MODEL_EXTRACTION=claude-sonnet-5
ANTHROPIC_MODEL_SUMMARY=claude-haiku-4-5
CLAUDE_CODE_BIN=claude

# ── Fal.ai media generation (lib/fal.js) ─────────────────────────────────────
# MOCK_MEDIA_GEN=1 → no real Fal calls (free local runs)
MOCK_MEDIA_GEN=1
FAL_KEY=
# Model ids are config-pinned, not hardcoded — verify current ids at fal.ai/models
FAL_IMAGE_MODEL=fal-ai/nano-banana-pro
FAL_VIDEO_MODEL=fal-ai/bytedance/seedance-2.0

# ── Storage (lib/storage.js) ─────────────────────────────────────────────────
# local → backend/data/media on disk; r2 → Cloudflare R2
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PROD=phantom2-prod
MEDIA_SIGNED_TTL_SEC=300

# ── Stripe (test mode until launch) ──────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Google OAuth (Phase 2) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Remotion graphics (lib/edit/remotion.js — post-build item 7) ─────────────
# unset/0 → today's chrome_overlay end-card only (default, byte-identical).
# 1 → motion-graphics overlays from the repo-root remotion/ project (run
#     `npm install` there once). Any render error falls back to chrome_overlay.
REMOTION_ENABLED=0
REMOTION_PROJECT_DIR=      # default <repo>/remotion
REMOTION_CONCURRENCY=      # parallel render workers (default 2)
REMOTION_TIMEOUT_MS=       # per-render timeout (default 180000)

# ── Misc ─────────────────────────────────────────────────────────────────────
PHANTOM_DB_PATH=            # default backend/data/phantom2.db (prod: /data/phantom2.db)
PUBLIC_BASE_URL=            # e.g. https://online-phantom.com (webhooks, invite links)
JOBS_CONCURRENCY=           # JSON, e.g. {"llm":2,"fal_image":8,"fal_video":4,"chrome":2}
GIT_SHA=
