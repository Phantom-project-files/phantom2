# ── Phantom 2.0 prod secrets ─────────────────────────────────────────────────
# Copy to backend/secrets.prod.env, fill in real values, then run:
#   DRY_RUN=0 backend/scripts/provision-phantom2.sh
# which pipes this file into ONE `fly secrets set` call (one machine restart).
#
# secrets.prod.env is gitignored (root .gitignore: *.env) and dockerignored —
# it must NEVER be committed or baked into the image. chmod 600 it.
#
# ONLY sensitive values live here. Non-sensitive prod config lives in
# backend/fly.toml [env] (PORT, COMING_SOON, STORAGE_BACKEND, PUBLIC_BASE_URL, …).

# ── Operator console login ───────────────────────────────────────────────────
# PLAN.md item 2 note: ADMIN_PASSWORD sat in the same plaintext rtf as the old
# keys — use a FRESH password here, not the local one.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Anthropic (rotated 2026-07-03 key) ───────────────────────────────────────
# fly.toml ships CLAUDE_MODE=mock; the key is inert until you flip to anthropic_api.
ANTHROPIC_API_KEY=

# ── Fal.ai (rotated 2026-07-03 key) ──────────────────────────────────────────
# fly.toml ships MOCK_MEDIA_GEN=1; the key is inert until you flip to 0.
FAL_KEY=

# ── Cloudflare R2 (bucket phantom2-prod) ─────────────────────────────────────
# Account ID: Cloudflare dashboard → R2 → right sidebar "Account ID".
# Keys: R2 → Manage R2 API Tokens → Create API Token → Object Read & Write,
#       scoped to bucket phantom2-prod only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PROD=phantom2-prod

# ── Google OAuth (PLAN item 3: prod redirect URI must be registered first) ───
# console.cloud.google.com → Credentials → the existing OAuth client →
# add https://phantom2.fly.dev/auth/google/callback (and later
# https://online-phantom.com/auth/google/callback at cutover). Publish consent screen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Stripe (PLAN item 4) ─────────────────────────────────────────────────────
# Start with TEST keys (sk_test_...) — lib/payments.js runs live-mode code paths
# whenever STRIPE_SECRET_KEY is set. Swap to sk_live_ + the live webhook signing
# secret at launch (see docs/runbooks/domain-cutover.md).
# Webhook secret: Stripe dashboard → Developers → Webhooks → endpoint
# https://phantom2.fly.dev/webhook/stripe → "Signing secret" (whsec_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Optional (leave blank to keep the safe defaults) ─────────────────────────
# AYRSHARE_API_KEY=        # Phase 7 publishing — unset → ayrshare mock mode
# AYRSHARE_PRIVATE_KEY=
# RESEND_API_KEY=          # agent email — unset + EMAIL_MODE unset → mock
